---
import { getEntry } from "astro:content";
import { SEO } from "astro-seo";
import { SkipLink } from "accessible-astro-components";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import "../assets/app.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseProfile = await getEntry("profile", "index");
const localizedProfile = await getEntry("profile", lang);

if (!baseProfile || !("name" in baseProfile.data)) {
  throw new Error("Missing or invalid content: profile/index");
}
if (!localizedProfile || !("bio" in localizedProfile.data)) {
  throw new Error(`Missing or invalid content: profile/${lang}`);
}

const { name, portrait } = baseProfile.data;
const pageTitle = title || t("nav.home");
const pageDescription = description || localizedProfile.data.bio;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(portrait, Astro.site).toString();
---

<!doctype html>
<html lang={lang} id="top" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={pageTitle}
      titleTemplate={`%s | ${name}`}
      titleDefault={`${t("nav.home")} | ${name}`}
      description={pageDescription}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: `${pageTitle} | ${name}`,
          type: "website",
          image: ogImageURL,
          url: canonicalURL,
        },
        optional: {
          description: pageDescription,
          locale: lang,
          siteName: name,
        },
      }}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SkipLink text={t("nav.skipToContent")} target="#main-content" />
    <Navbar />
    <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
