---
import { languages } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<button
  type="button"
  class="btn btn-ghost btn-square"
  popovertarget="language-menu"
  style="anchor-name:--language-menu"
  aria-label={t("nav.selectLanguage")}
>
  <span class="icon-[lucide--globe] h-6 w-6" aria-hidden="true"></span>
</button>

<ul
  popover
  id="language-menu"
  style="position-anchor:--language-menu"
  class="dropdown dropdown-end menu w-40 rounded-box bg-base-100 p-2 shadow-sm"
>
  {Object.entries(languages).map(([lang, label]) => (
    <li>
      <a
        href={`/${lang}/`}
        lang={lang}
        hreflang={lang}
        class:list={{ "menu-active": lang === currentLang }}
        aria-current={lang === currentLang ? "page" : undefined}
      >
        {label}
      </a>
    </li>
  ))}
</ul>
