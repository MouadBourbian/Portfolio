---
import { getCollection } from "astro:content";
import { sectionIds } from "../constants/sections";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const technologies = await getCollection("technologies");
---

<section
  aria-labelledby={sectionIds.technologies}
  class="prose max-w-none mb-12 sm:mb-16"
>
  <h2 id={sectionIds.technologies}>{t("technologies.title")}</h2>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
    {technologies.map(({ data }) => (
      <div class="card bg-base-200 rounded-lg">
        <div class="card-body items-center justify-center p-6 text-center">
          <span class:list={[data.icon, "h-10 w-10"]} aria-hidden="true" />
          <span class="mt-2">{data.name}</span>
        </div>
      </div>
    ))}
  </div>
</section>
