---
import { getCollection, getEntry } from "astro:content";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const baseProfile = await getEntry("profile", "index");
const localizedProfile = await getEntry("profile", lang);

if (!baseProfile || !("name" in baseProfile.data)) {
  throw new Error("Missing or invalid content: profile/index");
}

if (!localizedProfile || !("role" in localizedProfile.data)) {
  throw new Error(`Missing or invalid content: profile/${lang}`);
}

const { name, portrait } = baseProfile.data;
const { role, bio } = localizedProfile.data;
const socials = await getCollection("socials");
---

<section
  class="hero min-h-screen bg-base-100 mb-12 sm:mb-16"
  style="background-image:
    radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--color-primary) 25%, transparent), transparent 45%),
    radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--color-secondary) 25%, transparent), transparent 45%);"
>
  <div class="hero-content w-full max-w-6xl flex-col-reverse justify-between gap-12 lg:flex-row">
    <div class="max-w-xl">
      <div class="badge badge-outline">{role}</div>
      <h1 class="mt-2 text-5xl font-bold tracking-tight">{name}</h1>
      <p class="py-6 text-base leading-relaxed text-base-content">{bio}</p>
      <div class="flex flex-wrap gap-2">
        {socials.map(({ data }) => (
          <a
            href={data.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={data.name}
            class="btn btn-ghost btn-square"
          >
            <span class:list={[data.icon, "h-6 w-6"]} aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>

    <div class="avatar">
      <div class="w-48 rounded-full bg-base-300 lg:w-64">
        <img src={portrait} alt={name} width="256" height="256" />
      </div>
    </div>
  </div>
</section>
