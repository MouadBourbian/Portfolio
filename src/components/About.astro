---
import { getEntry, render } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { sectionIds } from "../constants/sections";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entry = await getEntry("about", `${lang}`);

if (!entry) throw new Error(`Missing content: about/${lang}`);

const { Content } = await render(entry);
---

<section
  aria-labelledby={sectionIds.about}
  class="prose max-w-none mb-12 sm:mb-16"
>
  <h2 id={sectionIds.about}>{t("about.title")}</h2>
  <div class="text-justify">
    <Content />
  </div>
</section>
