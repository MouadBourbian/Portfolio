---
import { getEntry } from "astro:content";
import { sectionIds } from "../constants/sections";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";

const lang = getLangFromUrl(Astro.url);

const baseProfile = await getEntry("profile", "index");

if (!baseProfile || !("name" in baseProfile.data)) {
  throw new Error("Missing or invalid content: profile/index");
}

const { name } = baseProfile.data;

const t = useTranslations(lang);
---

<header class="navbar bg-base-100 border-base-200 sticky top-0 z-50 border-b px-4">
  <div class="navbar-start">
    <div class="dropdown md:hidden">
      <div
        tabindex="0"
        role="button"
        class="btn btn-ghost btn-square"
        aria-label={t("nav.menu")}
      >
        <span class="icon-[lucide--menu] h-6 w-6"></span>
      </div>

      <ul
        tabindex="0"
        class="menu dropdown-content bg-base-100 rounded-box border-base-200 z-10 mt-3 w-52 border p-2 shadow-sm"
      >
        {Object.values(sectionIds).map((id) => (
          <li>
            <a href={`/${lang}/#${id}`}>{t(`nav.${id}`)}</a>
          </li>
        ))}
      </ul>
    </div>

    <a href={`/${lang}/`} class="btn btn-ghost" aria-label={t("nav.home")}>
      <span class="text-lg font-bold">{name}</span>
    </a>
  </div>

  <nav class="navbar-center hidden md:flex" aria-label={t("nav.navigation")}>
    <ul class="menu menu-horizontal gap-2 px-1">
      {Object.values(sectionIds).map((id) => (
        <li>
          <a href={`/${lang}/#${id}`}>{t(`nav.${id}`)}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="navbar-end">
    <LanguagePicker />
  </div>
</header>
